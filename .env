# Значения по умолчанию (используются при обычном `docker compose up`).
# sync | async — синхронный HTTP-вызов Loyalty или событие TicketSold через RabbitMQ
MODE=sync
# сколько запросов Tickets обрабатывает одновременно (шаг 2: 4)
WORKER_THREADS=4
# искусственная задержка ответа Loyalty, мс (шаг 1: 1500, шаг 2: 20000)
LOYALTY_DELAY_MS=0
# таймаут вызова Loyalty из Tickets, с; 0 — без таймаута
LOYALTY_TIMEOUT_SEC=0
# поддержка заголовка Idempotency-Key
IDEMPOTENCY_ENABLED=true
# circuit breaker на вызов Loyalty
BREAKER_ENABLED=false
BREAKER_FAIL_THRESHOLD=5
BREAKER_OPEN_SEC=10
# naive — «прибавить баллы» к счётчику; idempotent — запись начисления с уникальным ticket_id
ACCRUAL_MODE=naive
POINTS_PER_TICKET=50
